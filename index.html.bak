<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<title>Shreyas V — DevOps & Database Engineer</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="Portfolio of Shreyas V, Microsoft Certified DevOps & Database Engineer at TCS, Bengaluru.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#17171c;--card:#212128;--ink:#f5f5f7;--ink-2:#d6d6de;--mute:#a0a0ad;--faint:#666672;
  --line:rgba(255,255,255,.14);--soft:#2b2b33;--on-ink:#17171c;--glass:rgba(33,33,40,.78);--portrait-blend:normal;
  --ease:cubic-bezier(.16,1,.3,1);--gutter:clamp(18px,4vw,64px);
  --sans:'Inter Tight',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
  --serif:'Instrument Serif',Georgia,'Times New Roman',serif;
  --mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  color-scheme:dark;
}
:root[data-theme="light"],:root[data-theme="dark"]{--paper:#17171c;--card:#212128;--ink:#f5f5f7;--ink-2:#d6d6de;--mute:#a0a0ad;--faint:#666672;
  --line:rgba(255,255,255,.14);--soft:#2b2b33;--on-ink:#17171c;--glass:rgba(33,33,40,.78);--portrait-blend:normal;}
*,*::before,*::after{box-sizing:border-box}
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 70px);scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.5;overflow-x:hidden;-webkit-font-smoothing:antialiased}
::selection{background:var(--ink);color:var(--paper)}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0}
img{max-width:100%;display:block}
:focus-visible{outline:2px solid var(--ink);outline-offset:3px;border-radius:6px}
.wrap{max-width:1320px;margin:0 auto;padding:0 var(--gutter)}
section{position:relative}
.sec{padding:clamp(96px,14vh,160px) 0}
.tag{font-family:var(--mono);font-size:12px;color:var(--mute);margin:0 0 18px;letter-spacing:.02em}
h1,h2,h3{margin:0;font-weight:700;letter-spacing:-.045em;line-height:1}
h2{font-size:clamp(40px,6.4vw,92px)}
h2 em,.acc{font-family:var(--serif);font-style:italic;font-weight:400;color:var(--mute);letter-spacing:-.02em}
p{margin:0}
.btn{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 24px;border-radius:999px;font-weight:600;font-size:15px;transition:transform .5s var(--ease),background .3s,color .3s,box-shadow .3s;white-space:nowrap}
.btn:hover{transform:translateY(-2px)}
.btn-p{background:var(--ink);color:var(--on-ink)}
.btn-p:hover{box-shadow:0 12px 30px -10px rgba(0,0,0,.5)}
.btn-s{box-shadow:inset 0 0 0 1px var(--line)}
.btn-s:hover{background:var(--ink);color:var(--on-ink)}
.rv{opacity:0;transform:translateY(24px);transition:opacity .9s var(--ease),transform .9s var(--ease);transition-delay:calc(var(--i,0)*80ms)}
.rv.is-in{opacity:1;transform:none}
.rv-mask{display:block;overflow:hidden;padding-bottom:.08em}
.rv-mask>span{display:block;transform:translateY(105%);transition:transform 1.1s var(--ease);transition-delay:calc(var(--i,0)*90ms)}
.rv-mask.is-in>span{transform:none}

/* NAV */
#progress{position:fixed;left:0;top:0;height:2px;width:100%;background:var(--ink);transform-origin:0 50%;transform:scaleX(0);z-index:90}
.nav{position:fixed;left:0;right:0;top:env(safe-area-inset-top,0px);z-index:80;display:flex;align-items:center;justify-content:space-between;padding:16px var(--gutter);pointer-events:none}
.nav>*{pointer-events:auto}
.brand{display:flex;align-items:center;gap:12px;font-weight:700;letter-spacing:-.02em}
.mark{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;font-size:14px;font-weight:700;box-shadow:inset 0 0 0 1.5px var(--ink);transition:background .4s,color .4s,transform .8s var(--ease)}
.brand:hover .mark{transform:rotate(360deg)}
.scrolled .mark{background:var(--ink);color:var(--on-ink)}
.brand-name{transition:opacity .4s,transform .4s var(--ease)}
.scrolled .brand-name{opacity:0;transform:translateX(-8px)}
.links{position:relative;display:flex;gap:2px;padding:5px;border-radius:999px;transition:background .4s,box-shadow .4s}
.scrolled .links{background:var(--glass);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);box-shadow:inset 0 0 0 1px var(--line),0 10px 30px -14px rgba(0,0,0,.25)}
.links a{position:relative;z-index:1;padding:8px 16px;font-size:14px;font-weight:500;border-radius:999px;transition:color .35s}
.links a.on{color:var(--on-ink)}
.pill{position:absolute;z-index:0;top:5px;bottom:5px;left:0;width:0;border-radius:999px;background:var(--ink);transition:transform .6s var(--ease),width .6s var(--ease);opacity:0}
.menu-btn{display:none;height:44px;padding:0 20px;border-radius:999px;background:var(--glass);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);box-shadow:inset 0 0 0 1px var(--line);font-weight:600;font-size:14px}
.overlay{position:fixed;inset:0;z-index:95;background:var(--paper);clip-path:circle(0 at calc(100% - 60px) 40px);transition:clip-path .8s var(--ease);visibility:hidden;padding:90px var(--gutter) 40px;display:flex;flex-direction:column;justify-content:center;gap:6px}
.overlay.open{clip-path:circle(150% at calc(100% - 60px) 40px);visibility:visible}
.overlay a{display:flex;align-items:baseline;gap:16px;font-size:clamp(36px,11vw,64px);font-weight:700;letter-spacing:-.045em;opacity:0;transform:translateY(30px);transition:opacity .6s var(--ease),transform .6s var(--ease);transition-delay:calc(var(--i)*60ms + 200ms)}
.overlay a small{font-family:var(--mono);font-size:12px;color:var(--mute);font-weight:400;letter-spacing:0}
.overlay.open a{opacity:1;transform:none}
.overlay .close{position:absolute;top:calc(env(safe-area-inset-top,0px) + 16px);right:var(--gutter);height:44px;padding:0 20px;border-radius:999px;box-shadow:inset 0 0 0 1px var(--line);font-weight:600;font-size:14px}
body.lock{overflow:hidden}
@media(max-width:860px){.links{display:none}.menu-btn{display:block}}

/* HERO */
.hero{min-height:100svh;display:grid;align-items:end;overflow:hidden;padding-top:90px}
.hero-grid{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.9fr) minmax(0,1fr);gap:24px;align-items:end;width:100%}
.ghost{position:absolute;left:50%;top:44%;transform:translate(-50%,-50%);font-size:clamp(100px,19vw,300px);font-weight:800;letter-spacing:-.06em;line-height:.8;color:transparent;-webkit-text-stroke:1.5px var(--line);white-space:nowrap;pointer-events:none;user-select:none;z-index:0}
.hero-text{position:relative;z-index:2;align-self:center;padding-bottom:60px}
.hello{display:inline-block;font-family:var(--mono);font-size:12px;color:var(--mute);padding:7px 14px;border-radius:999px;box-shadow:inset 0 0 0 1px var(--line);margin-bottom:22px}
.hero h1{font-size:clamp(40px,4.7vw,78px)}
.hero .sub{margin-top:18px;font-size:clamp(16px,1.4vw,20px);color:var(--mute);max-width:30ch}
.bubble{margin-top:28px;max-width:420px;background:var(--card);border-radius:24px 24px 24px 6px;padding:20px 22px;font-size:15px;color:var(--ink-2);box-shadow:inset 0 0 0 1px var(--line),0 24px 50px -30px rgba(0,0,0,.35)}
.bubble b{color:var(--ink)}
.ctas{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
.speak{display:flex;align-items:center;gap:10px;margin-top:14px;font-family:var(--mono);font-size:12px;color:var(--mute);min-height:22px}
.wave{display:inline-flex;gap:3px;align-items:center;height:16px}
.wave i{width:3px;height:4px;border-radius:2px;background:var(--ink);opacity:.25}
.speaking .wave i{opacity:1;animation:eq .9s ease-in-out infinite}
.speaking .wave i:nth-child(2){animation-delay:.15s}.speaking .wave i:nth-child(3){animation-delay:.3s}.speaking .wave i:nth-child(4){animation-delay:.45s}
@keyframes eq{0%,100%{height:4px}50%{height:16px}}
.portrait-wrap{position:relative;justify-self:center;width:min(100%,460px);align-self:end}
.portrait-wrap img{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;mix-blend-mode:var(--portrait-blend);-webkit-mask-image:linear-gradient(#000 70%,transparent 100%);mask-image:linear-gradient(#000 70%,transparent 100%);border-radius:28px 28px 0 0}
.facts{position:relative;z-index:2;align-self:center;display:grid;gap:12px;justify-items:start;padding-bottom:60px;justify-self:end}
.fact{background:var(--glass);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-radius:20px;padding:14px 20px;box-shadow:inset 0 0 0 1px var(--line);min-width:220px}
.fact b{display:block;font-size:30px;letter-spacing:-.04em;line-height:1.1}
.fact span{font-size:13px;color:var(--mute)}
.fact:nth-child(2){transform:translateX(-22px)}
@media(max-width:980px){
  .hero-grid{grid-template-columns:1fr;gap:0}
  .portrait-wrap{order:-1;width:min(78%,380px);margin-top:10px}
  .hero-text{padding-bottom:30px;margin-top:-40px}
  .facts{justify-self:start;grid-auto-flow:column;grid-auto-columns:1fr;width:100%;padding-bottom:40px;gap:8px}
  .fact{min-width:0;padding:12px 14px}.fact b{font-size:22px}.fact:nth-child(2){transform:none}
  .ghost{top:30%}
}
@media(max-width:560px){.facts{grid-auto-flow:row}}

/* ABOUT */
.about-grid{display:grid;grid-template-columns:minmax(0,1fr) 320px minmax(0,1fr);gap:clamp(24px,4vw,64px);align-items:stretch;margin-top:56px}
.about-l p{font-size:clamp(16px,1.25vw,19px);color:var(--ink-2);max-width:52ch}
.about-l .hi{font-size:clamp(34px,3.6vw,52px);font-weight:700;letter-spacing:-.045em;line-height:1.05;margin-bottom:22px;color:var(--ink)}
.about-l .row{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
.lanyard{position:relative;display:flex;justify-content:center;min-height:580px}
.swing{position:absolute;top:-70px;left:50%;width:300px;margin-left:-150px;transform-origin:50% 0;will-change:transform;display:flex;flex-direction:column;align-items:center}
.strap{width:30px;height:125px;background:var(--ink);overflow:hidden;position:relative;border-radius:0 0 3px 3px}
.strap div{position:absolute;left:0;right:0;top:0;display:flex;flex-direction:column;align-items:center;gap:14px;padding-top:10px;animation:strap 9s linear infinite}
.strap span{writing-mode:vertical-rl;color:var(--on-ink);font-family:var(--mono);font-size:10px;letter-spacing:.14em;white-space:nowrap}
@keyframes strap{to{transform:translateY(-50%)}}
.clip{width:18px;height:26px;border-radius:4px 4px 8px 8px;background:linear-gradient(90deg,#8d8d8d,#e4e4e4,#8d8d8d);box-shadow:0 2px 4px rgba(0,0,0,.3);margin-top:-2px}
.idcard{width:300px;height:404px;perspective:1200px;margin-top:-4px;cursor:pointer;border-radius:26px}
.idin{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .9s var(--ease)}
.idcard.flip .idin{transform:rotateY(180deg)}
.face{position:absolute;inset:0;border-radius:26px;background:#fff;color:#0d0d0d;backface-visibility:hidden;-webkit-backface-visibility:hidden;overflow:hidden;box-shadow:inset 0 0 0 1px rgba(21,18,59,.1),0 40px 70px -34px rgba(0,0,0,.55)}
.face.back{transform:rotateY(180deg);padding:26px 24px}
.band{background:#0d0d0d;color:#fff;font-family:var(--mono);font-size:11px;letter-spacing:.2em;text-align:center;padding:12px 0}
.ph{width:128px;height:156px;margin:20px auto 0;border-radius:20px;padding:3px;background:linear-gradient(135deg,#bdbdbd,#f2f2f2,#8f8f8f);box-shadow:0 0 0 6px rgba(0,0,0,.04),0 16px 30px -14px rgba(0,0,0,.4);overflow:hidden}
.ph img{width:100%;height:100%;object-fit:cover;object-position:50% 20%;border-radius:17px;transition:transform .8s var(--ease)}
.idcard:hover .ph img{transform:scale(1.07)}
.idn{text-align:center;margin-top:14px;font-weight:700;font-size:21px;letter-spacing:-.03em}
.idr{text-align:center;font-size:12px;color:#77756f}
.idrows{margin:12px 26px 0;display:grid;gap:3px;font-size:11px}
.idrows div{display:flex;justify-content:space-between;border-bottom:1px dashed rgba(13,13,13,.14);padding-bottom:3px}
.idrows span{color:#77756f;font-family:var(--mono)}
.idfoot{position:absolute;left:26px;right:26px;bottom:16px;display:flex;justify-content:space-between;align-items:flex-end}
.barcode{height:30px;width:150px;background:repeating-linear-gradient(90deg,#0d0d0d 0 2px,transparent 2px 4px,#0d0d0d 4px 5px,transparent 5px 8px,#0d0d0d 8px 11px,transparent 11px 12px)}
.holo{width:34px;height:34px;border-radius:50%;background:conic-gradient(#e5e5e5,#9a9a9a,#f7f7f7,#8a8a8a,#e5e5e5);box-shadow:inset 0 0 0 1px rgba(0,0,0,.15)}
.back h4{margin:0 0 14px;font-size:22px;letter-spacing:-.03em}
.back li{font-size:13px;color:#3a3a3a;padding:7px 0;border-bottom:1px solid rgba(13,13,13,.08);list-style:none}
.back ul{margin:0;padding:0}
.sign{position:absolute;left:24px;right:24px;bottom:22px;font-family:var(--serif);font-style:italic;font-size:20px;color:#77756f}
.sign small{display:block;font-family:var(--mono);font-style:normal;font-size:10px;margin-top:4px}
.hint{position:absolute;bottom:0;left:0;right:0;text-align:center;font-family:var(--mono);font-size:11px;color:var(--mute)}
.about-r h3{font-size:14px;font-family:var(--mono);font-weight:500;letter-spacing:0;color:var(--mute);margin-bottom:12px}
.qf{display:grid}
.qf div{display:flex;justify-content:space-between;gap:16px;padding:15px 0;border-bottom:1px solid var(--line);font-size:15px}
.qf span{color:var(--mute);flex:none}.qf b{font-weight:500;text-align:right;overflow-wrap:anywhere}
.quote{margin-top:30px;font-family:var(--serif);font-style:italic;font-size:clamp(22px,2vw,28px);line-height:1.2;letter-spacing:-.01em;color:var(--ink-2)}
@media(max-width:1000px){
  .about-grid{grid-template-columns:1fr}
  .lanyard{min-height:580px;order:-1;margin-top:30px}
}

/* SKILLS */
.skills-top{display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:flex-end}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:36px}
.chip{height:38px;padding:0 16px;border-radius:999px;font-size:13px;font-weight:500;box-shadow:inset 0 0 0 1px var(--line);transition:background .3s,color .3s,transform .4s var(--ease)}
.chip:hover{transform:translateY(-1px)}
.chip.on{background:var(--ink);color:var(--on-ink)}
.ptable{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:28px;margin-top:28px;align-items:start}
.grid{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:10px}
.tile{position:relative;aspect-ratio:1/1.08;background:var(--card);border-radius:16px;box-shadow:inset 0 0 0 1px var(--line);padding:8px 9px;text-align:left;display:flex;flex-direction:column;justify-content:space-between;opacity:0;transform:translateY(14px) scale(.96);transition:opacity .7s var(--ease),transform .7s var(--ease),background .3s,color .3s,box-shadow .3s;transition-delay:var(--d,0ms),var(--d,0ms),0s,0s,0s;min-width:0}
.grid.in .tile{opacity:1;transform:none}
.grid.in .tile.dim{opacity:.22;transition-delay:0s}
.tile:hover,.tile.sel{background:var(--ink);color:var(--on-ink);transform:translateY(-3px);transition-delay:0s;box-shadow:0 18px 30px -16px rgba(0,0,0,.5)}
.tile .n{font-family:var(--mono);font-size:10px;color:var(--mute)}
.tile:hover .n,.tile.sel .n{color:var(--faint)}
.tile .s{font-size:clamp(20px,2.6vw,34px);font-weight:700;letter-spacing:-.05em;line-height:1}
.tile .m{font-size:10.5px;line-height:1.15;color:var(--ink-2);overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.tile:hover .m,.tile.sel .m{color:var(--on-ink)}
.insp{position:sticky;top:96px;background:var(--card);border-radius:28px;padding:28px;box-shadow:inset 0 0 0 1px var(--line),0 30px 60px -40px rgba(0,0,0,.4);min-height:340px}
.insp .big{width:150px;height:150px;margin:0 auto 18px;border-radius:32px;display:grid;place-items:center;background:var(--paper);box-shadow:inset 0 0 0 1px var(--line);font-size:64px;font-weight:700;letter-spacing:-.06em}
.insp .big.pop{animation:pop .6s var(--ease)}
@keyframes pop{from{transform:scale(.7);opacity:.2}to{transform:none;opacity:1}}
.insp h3{font-size:28px}
.insp .fam{font-family:var(--mono);font-size:12px;color:var(--mute);margin:6px 0 14px}
.insp p{font-size:14px;color:var(--ink-2)}
@media(max-width:1000px){.ptable{grid-template-columns:1fr}.insp{position:static;order:2}}
@media(max-width:640px){.grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.tile .s{font-size:22px}.tile .m{font-size:9.5px}}

/* CERTS */
.band-w{background:var(--card);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.certs{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.4fr);gap:clamp(24px,5vw,80px)}
.certs .stick{position:sticky;top:120px;align-self:start}
.certs .count{margin-top:22px;font-family:var(--mono);font-size:13px;color:var(--mute)}
.crow{position:relative;display:flex;align-items:center;gap:22px;padding:26px 22px;border-bottom:1px solid var(--line);overflow:hidden;outline-offset:-2px}
.crow::before{content:"";position:absolute;inset:0;background:var(--ink);transform:scaleX(0);transform-origin:0 50%;transition:transform .7s var(--ease);z-index:0}
.crow>*{position:relative;z-index:1;transition:color .4s}
.crow:hover::before,.crow:focus-visible::before{transform:scaleX(1)}
.crow:hover>*,.crow:focus-visible>*{color:var(--on-ink)}
.crow .i{font-family:var(--mono);font-size:12px;color:var(--mute);width:28px}
.crow .t{flex:1;font-size:clamp(17px,1.7vw,23px);font-weight:600;letter-spacing:-.03em;line-height:1.2}
.crow .t small{display:block;font-weight:400;font-size:13px;color:var(--mute);letter-spacing:0;margin-top:4px}
.crow:hover .t small,.crow:focus-visible .t small{color:var(--faint)}
.crow .a{transform:translateX(-14px);opacity:0;transition:transform .6s var(--ease),opacity .4s;font-size:20px}
.crow:hover .a,.crow:focus-visible .a{transform:none;opacity:1}
@media(max-width:860px){.certs{grid-template-columns:1fr}.certs .stick{position:static}}

/* EXPERIENCE */
.tl{position:relative;margin-top:64px;padding-left:clamp(28px,5vw,64px);max-width:980px}
.spine{position:absolute;left:6px;top:8px;bottom:8px;width:2px;background:var(--line)}
.spine i{position:absolute;inset:0;background:var(--ink);transform-origin:0 0;transform:scaleY(0)}
.stop{position:relative;padding-bottom:64px;opacity:.35;transition:opacity .6s var(--ease)}
.stop::before{content:"";position:absolute;left:calc(-1*clamp(28px,5vw,64px) + 0px);top:8px;width:14px;height:14px;border-radius:50%;background:var(--paper);box-shadow:inset 0 0 0 2px var(--faint);transition:background .5s,box-shadow .5s}
.stop.lit{opacity:1}
.stop.lit::before{background:var(--ink);box-shadow:inset 0 0 0 2px var(--ink)}
.stop .yr{font-family:var(--mono);font-size:12px;color:var(--mute)}
.stop h3{font-size:clamp(26px,3.2vw,44px);margin:10px 0 6px}
.stop .pl{color:var(--mute);font-size:16px;margin-bottom:14px}
.stop ul{margin:0;padding-left:18px;color:var(--ink-2);font-size:15px;max-width:68ch}
.stop li{margin:6px 0}
.stop .dist{display:inline-block;margin-top:6px;font-size:13px;font-weight:600;padding:5px 12px;border-radius:999px;box-shadow:inset 0 0 0 1px var(--line)}
.next{border:1.5px dashed var(--faint);border-radius:28px;padding:30px 32px;display:flex;justify-content:space-between;gap:16px;align-items:center;flex-wrap:wrap}
.next b{font-size:clamp(22px,2.4vw,32px);letter-spacing:-.04em}

/* ACHIEVEMENTS */
.ach{height:var(--ah,300vh)}
.pin{position:sticky;top:0;height:100svh;overflow:hidden;display:flex;flex-direction:column;justify-content:center}
.ach-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:40px;flex-wrap:wrap}
.pbar{height:2px;width:min(260px,100%);background:var(--line);margin-bottom:12px}
.pbar i{display:block;height:100%;background:var(--ink);transform-origin:0 0;transform:scaleX(0)}
.track{display:flex;gap:24px;padding:20px var(--gutter) 30px;will-change:transform;width:max-content}
.acard{position:relative;flex:none;width:clamp(300px,40vw,540px);height:clamp(260px,36vh,310px);background:var(--card);border-radius:28px;padding:24px 28px;box-shadow:inset 0 0 0 1px var(--line),0 20px 40px -34px rgba(0,0,0,.3);display:flex;flex-direction:column;justify-content:space-between;transition:transform .8s var(--ease),box-shadow .8s var(--ease)}
.acard.near{transform:translateY(-12px);box-shadow:inset 0 0 0 1px var(--line),0 40px 60px -30px rgba(0,0,0,.4)}
.acard .top{display:flex;justify-content:space-between;align-items:center}
.logo{width:72px;height:72px;border-radius:20px;background:var(--paper);box-shadow:inset 0 0 0 1px var(--line);display:grid;place-items:center;font-size:26px;font-weight:700;letter-spacing:-.05em;transition:box-shadow .8s}
.acard.near .logo{box-shadow:inset 0 0 0 1px var(--line),0 0 40px 6px rgba(120,120,120,.25)}
.acard .idx{font-family:var(--mono);font-size:12px;color:var(--mute)}
.acard .bot{display:flex;justify-content:space-between;align-items:flex-end;gap:16px}
.acard .lb{font-size:clamp(18px,1.6vw,22px);font-weight:700;letter-spacing:-.03em;margin-bottom:6px}
.acard .cp{font-size:13px;color:var(--mute);max-width:26ch;line-height:1.35}
.acard .num{font-size:clamp(48px,6.4vw,92px);font-weight:700;letter-spacing:-.06em;line-height:.85;white-space:nowrap}
.acard .num.t{font-size:clamp(30px,3.8vw,54px)}
.end{flex:none;align-self:center;font-family:var(--serif);font-style:italic;font-size:clamp(32px,4vw,56px);color:var(--mute);padding:0 60px 0 20px;white-space:nowrap}
@media(max-width:700px){.ach{height:auto}.pin{position:static;height:auto;padding:var(--pad,0) 0}.track{width:auto;overflow-x:auto;scroll-snap-type:x mandatory;transform:none!important}.acard{scroll-snap-align:center}.pbar{display:none}}

/* CONTACT */
.contact{padding-bottom:60px}
.contact h2{font-size:clamp(46px,9vw,150px);line-height:.95}
.contact h2 .l{display:inline-block;transition:transform .5s var(--ease)}
.contact h2 .l.hop{transform:translateY(-.14em)}
.mail{display:inline-flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:56px}
.mail a.big{font-size:clamp(22px,3.6vw,52px);font-weight:600;letter-spacing:-.04em;border-bottom:2px solid var(--ink);line-height:1.15;overflow-wrap:anywhere}
.copy{height:38px;padding:0 16px;border-radius:999px;box-shadow:inset 0 0 0 1px var(--line);font-size:13px;font-weight:600;transition:background .3s,color .3s}
.copy:hover{background:var(--ink);color:var(--on-ink)}
.links2{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
.badge{position:absolute;right:var(--gutter);top:0;width:140px;height:140px;animation:spin 18s linear infinite}
.badge text{font-family:var(--mono);font-size:11px;letter-spacing:.2em;fill:var(--ink)}
@keyframes spin{to{transform:rotate(360deg)}}
footer{border-top:1px solid var(--line);padding:26px 0 40px;font-size:13px;color:var(--mute)}
footer .wrap{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
@media(max-width:700px){.badge{width:96px;height:96px;top:-30px}}

@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .strap div,.badge,.speaking .wave i{animation:none}
  .rv,.rv-mask>span,.tile{transition:none;opacity:1;transform:none}
}

/* ===== MAGIC THEME ===== */
:root{--g1:#6d5efc;--g2:#00b8ff;--g3:#ff5fa2;--g4:#ffb86b;
 --grad:linear-gradient(120deg,var(--g1),var(--g2) 45%,var(--g3) 80%,var(--g4));
 --gloop:linear-gradient(90deg,var(--g1),var(--g2),var(--g3),var(--g4),var(--g1))}
@keyframes shift{to{background-position:300% 0}}
.aurora{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
.aurora i{position:absolute;width:55vmax;height:55vmax;border-radius:50%;filter:blur(90px);opacity:.42;animation:drift 28s ease-in-out infinite alternate;will-change:transform}
.aurora i:nth-child(1){background:var(--g1);left:-18vmax;top:-22vmax}
.aurora i:nth-child(2){background:var(--g2);right:-22vmax;top:8vmax;opacity:.32;animation-delay:-9s}
.aurora i:nth-child(3){background:var(--g3);left:18vw;bottom:-32vmax;opacity:.28;animation-delay:-17s}
@keyframes drift{to{transform:translate(8vmax,6vmax) scale(1.15)}}
.spot{position:fixed;left:0;top:0;width:560px;height:560px;margin:-280px 0 0 -280px;border-radius:50%;pointer-events:none;z-index:1;background:radial-gradient(circle,rgba(109,94,252,.16),rgba(0,184,255,.07) 42%,transparent 70%);opacity:0;transition:opacity .6s}
.spot.on{opacity:1}
#fx{position:fixed;inset:0;z-index:3;pointer-events:none}
h2 em,.acc{background:var(--gloop);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;animation:shift 10s linear infinite;padding-right:.06em}
.contact h2 em{background:none;-webkit-text-fill-color:initial;animation:none}
.ghost{-webkit-text-stroke:0;background:var(--gloop);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;opacity:.2;animation:shift 14s linear infinite}
.hello::before{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--grad);margin-right:8px;animation:ping 2.2s infinite}
@keyframes ping{0%{box-shadow:0 0 0 0 rgba(109,94,252,.6)}80%,100%{box-shadow:0 0 0 10px rgba(109,94,252,0)}}
.portrait-wrap::before{content:"";position:absolute;left:4%;right:4%;top:6%;bottom:-4%;border-radius:50%;background:conic-gradient(from 0deg,var(--g1),var(--g2),var(--g3),var(--g4),var(--g1));filter:blur(64px);opacity:.5;animation:spin 16s linear infinite;z-index:-1}
.bubble{background:linear-gradient(var(--card),var(--card)) padding-box,var(--grad) border-box;border:1.5px solid transparent;box-shadow:0 24px 50px -28px rgba(109,94,252,.5)}
.btn-p{background:var(--grad);background-size:160% 100%;color:#fff;transition:transform .5s var(--ease),background-position .5s,box-shadow .3s}
.btn-p:hover{background-position:100% 0;box-shadow:0 14px 34px -10px rgba(109,94,252,.65)}
.btn-s:hover{background:var(--grad);color:#fff;box-shadow:none}
.copy:hover{background:var(--grad);color:#fff}
#progress{background:var(--grad)}
.scrolled .mark{background:var(--grad);color:#fff;box-shadow:none}
.pill{background:var(--grad)}.links a.on{color:#fff}
.fact{box-shadow:inset 0 0 0 1px var(--line),0 18px 40px -28px rgba(109,94,252,.5);transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .5s var(--ease)}
.fact b{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent}
.fact:nth-child(2){transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));margin-left:22px}
@media(max-width:980px){.fact:nth-child(2){margin-left:0}}
.strap{background:var(--grad)}
.band{background:linear-gradient(120deg,#15123b,#4b3fd6)}
.ph{background:var(--grad)}
.holo{background:conic-gradient(#ff9ad0,#a99bff,#7de3ff,#ffe29a,#ff9ad0);box-shadow:inset 0 0 0 1px rgba(0,0,0,.12)}
.face{box-shadow:inset 0 0 0 1px rgba(21,18,59,.1),0 40px 70px -30px rgba(109,94,252,.55)}
.chip{display:inline-flex;align-items:center}
.chip::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--c,var(--g1));margin-right:8px}
.chip.on{background:var(--c,var(--g1));color:#fff}.chip.on::before{background:#fff}
.tile{--c:#6d5efc;overflow:hidden}
.tile::after{content:"";position:absolute;inset:0;border-radius:16px;background:radial-gradient(circle at 25% 0%,color-mix(in srgb,var(--c) 26%,transparent),transparent 62%);pointer-events:none}
.tile>*{position:relative;z-index:1}
.tile .s{color:var(--c)}
.tile:hover,.tile.sel{background:var(--c);color:#fff;box-shadow:0 18px 34px -12px var(--c)}
.tile:hover .s,.tile.sel .s,.tile:hover .m,.tile.sel .m{color:#fff}
.tile:hover .n,.tile.sel .n{color:rgba(255,255,255,.75)}
.tile:hover::after,.tile.sel::after{opacity:.4}
.insp{--c:#6d5efc;transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .5s var(--ease);box-shadow:inset 0 0 0 1px var(--line),0 30px 60px -36px var(--c)}
.insp .big{position:relative;background:linear-gradient(135deg,var(--c),color-mix(in srgb,var(--c) 45%,#fff));color:#fff;box-shadow:0 20px 40px -18px var(--c)}
.insp .big::after{content:"";position:absolute;inset:-8px;border-radius:38px;background:conic-gradient(from 0deg,transparent,var(--c),transparent 40%);-webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 3px),#000 calc(100% - 3px));mask:radial-gradient(farthest-side,transparent calc(100% - 3px),#000 calc(100% - 3px));animation:spin 4s linear infinite;opacity:.8}
.band-w{background:color-mix(in srgb,var(--card) 62%,transparent);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.crow::before{background:var(--grad)}
.crow:hover>*,.crow:focus-visible>*{color:#fff}
.crow:hover .t small,.crow:focus-visible .t small{color:rgba(255,255,255,.8)}
.spine i{background:linear-gradient(var(--g1),var(--g2),var(--g3))}
.stop.lit::before{background:var(--grad);box-shadow:0 0 0 4px rgba(109,94,252,.18),0 0 18px rgba(0,184,255,.6)}
.stop .dist{background:var(--grad);color:#fff;box-shadow:none}
.next{border-color:var(--g1)}
.pbar i{background:var(--grad)}
.acard{transform:perspective(900px) translateY(var(--ty,0px)) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg))}
.acard.near{--ty:-12px;transform:perspective(900px) translateY(-12px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));box-shadow:inset 0 0 0 1px var(--line),0 40px 60px -28px rgba(109,94,252,.55)}
.acard .logo{background:var(--grad);color:#fff;box-shadow:none}
.acard.near .logo{box-shadow:0 0 40px 6px rgba(109,94,252,.4)}
.acard .num{background:var(--gloop);background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;animation:shift 9s linear infinite}
.contact h2 .l{transition:transform .5s var(--ease)}
.kbtn{position:fixed;right:18px;bottom:calc(env(safe-area-inset-bottom,0px) + 18px);z-index:70;height:40px;padding:0 16px;border-radius:999px;background:var(--glass);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);box-shadow:inset 0 0 0 1px var(--line),0 12px 30px -14px rgba(109,94,252,.6);font-family:var(--mono);font-size:12px;color:var(--ink-2);transition:transform .4s var(--ease)}
.kbtn:hover{transform:translateY(-2px)}
.cmd{position:fixed;inset:0;z-index:120;display:none;align-items:flex-start;justify-content:center;padding:14vh 16px 0;background:rgba(21,18,59,.35);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
.cmd.open{display:flex}
.cmd-box{width:min(560px,100%);background:var(--card);border-radius:24px;box-shadow:inset 0 0 0 1px var(--line),0 40px 90px -30px rgba(109,94,252,.7);overflow:hidden;animation:pop .45s var(--ease)}
.cmd input{width:100%;border:0;outline:0;background:none;padding:20px 22px;font:500 17px var(--sans);color:var(--ink);border-bottom:1px solid var(--line)}
.cmd ul{list-style:none;margin:0;padding:8px;max-height:46vh;overflow:auto}
.cmd li{display:flex;justify-content:space-between;gap:12px;padding:12px 14px;border-radius:14px;font-size:15px;cursor:pointer}
.cmd li small{font-family:var(--mono);color:var(--mute);font-size:11px}
.cmd li.on{background:var(--grad);color:#fff}.cmd li.on small{color:rgba(255,255,255,.8)}
@media(max-width:700px){.kbtn{display:none}}
@media(prefers-reduced-motion:reduce){.aurora i,.ghost,h2 em,.acc,.acard .num,.portrait-wrap::before,.insp .big::after,.hello::before{animation:none}}
.aurora{display:none!important}
.portrait-wrap::before{opacity:.16}
.spot{background:radial-gradient(circle,rgba(255,255,255,.06),transparent 70%)}
html,body{background:#17171c;color:#f5f5f7}
.pimg{mix-blend-mode:normal!important}
</style>
</head>
<body>
<div class="aurora" aria-hidden="true"><i></i><i></i><i></i></div>
<div class="spot" id="spot" aria-hidden="true"></div>
<div id="progress" aria-hidden="true"></div>

<header class="nav" id="nav">
  <a class="brand" href="#top" aria-label="Shreyas V, back to top"><span class="mark">SV</span><span class="brand-name">Shreyas V</span></a>
  <nav class="links" id="links" aria-label="Primary">
    <span class="pill" id="pill"></span>
    <a href="#about">About</a><a href="#skills">Skills</a><a href="#certifications">Certifications</a><a href="#experience">Experience</a><a href="#achievements">Achievements</a><a href="#contact">Contact</a>
  </nav>
  <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="overlay">Menu</button>
</header>
<div class="overlay" id="overlay" role="dialog" aria-modal="true" aria-label="Menu">
  <button class="close" id="closeBtn">Close</button>
  <a href="#about" style="--i:0"><small>01</small>About</a>
  <a href="#skills" style="--i:1"><small>02</small>Skills</a>
  <a href="#certifications" style="--i:2"><small>03</small>Certifications</a>
  <a href="#experience" style="--i:3"><small>04</small>Experience</a>
  <a href="#achievements" style="--i:4"><small>05</small>Achievements</a>
  <a href="#contact" style="--i:5"><small>06</small>Contact</a>
</div>

<main id="top">
<!-- HERO -->
<section class="hero" id="hero" aria-label="Introduction">
  <div class="wrap" style="width:100%">
    <div class="hero-grid">
      <div class="ghost" aria-hidden="true">SHREYAS</div>
      <div class="hero-text">
        <span class="hello">Hello! I'm Shreyas</span>
        <h1><span class="rv-mask"><span>DevOps &amp;</span></span><span class="rv-mask" style="--i:1"><span>Database <span class="acc">Engineer.</span></span></span></h1>
        <p class="sub rv" style="--i:3">Microsoft Certified Azure Professional</p>
        <div class="bubble rv" style="--i:4">Hi, I'm <b>Shreyas</b>. I'm a DevOps &amp; Database Engineer at TCS with <b>1.7+ years</b> of experience, specialized in Microsoft Azure, PostgreSQL, CI/CD and Terraform.</div>
        <div class="ctas rv" style="--i:5">
          <button class="btn btn-p" id="introBtn" aria-label="Play spoken introduction">▶ Introduce me</button>
          <a class="btn btn-s" href="#skills">Explore skills</a>
          <a class="btn btn-s" href="#contact">Let's talk</a>
        </div>
        <div class="speak" id="speak" aria-live="polite"><span class="wave" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span id="speakTxt">Tap “Introduce me” to hear a short intro.</span></div>
      </div>
      <div class="portrait-wrap rv" style="--i:2"><img class="pimg" alt="Portrait of Shreyas V, wearing a black shirt with a white panel" width="480" height="600"></div>
      <div class="facts rv" style="--i:5">
        <div class="fact"><b>1.7+</b><span>years at Tata Consultancy Services</span></div>
        <div class="fact"><b>5</b><span>Microsoft certifications</span></div>
        <div class="fact"><b>Bengaluru</b><span>Karnataka, India</span></div>
      </div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section class="sec" id="about" style="padding-top:clamp(60px,9vh,100px)">
  <div class="wrap">
    <p class="tag rv">01 — About</p>
    <h2 class="rv-mask"><span>Cloud, data and <em>reliability.</em></span></h2>
    <div class="about-grid">
      <div class="about-l rv">
        <div class="hi">Hi, I'm Shreyas.</div>
        <p>Microsoft Certified DevOps &amp; Database Engineer with 1.7+ years of experience at Tata Consultancy Services (TCS), specializing in Microsoft Azure, PostgreSQL Database Administration, DevOps, Cloud Infrastructure, Disaster Recovery, and Infrastructure as Code.</p>
        <p style="margin-top:14px">Hands-on experience in AWS-to-Azure migration, PostgreSQL cluster creation and restoration, CI/CD pipeline management and Terraform-based infrastructure provisioning.</p>
        <div class="row">
          <a class="btn btn-p" href="https://github.com/Shreyasv006" target="_blank" rel="noopener">GitHub ↗</a>
          <a class="btn btn-s" href="https://www.linkedin.com/in/shreyasv006" target="_blank" rel="noopener">LinkedIn ↗</a>
          <a class="btn btn-s" href="#contact">Get in touch</a>
        </div>
      </div>
      <div class="lanyard" id="lanyard">
        <div class="swing" id="swing">
          <div class="strap" aria-hidden="true"><div>
            <span>SHREYAS V · DEVOPS &amp; DATABASE ENGINEER</span><span>SHREYAS V · DEVOPS &amp; DATABASE ENGINEER</span><span>SHREYAS V · DEVOPS &amp; DATABASE ENGINEER</span><span>SHREYAS V · DEVOPS &amp; DATABASE ENGINEER</span>
          </div></div>
          <div class="clip" aria-hidden="true"></div>
          <div class="idcard" id="idcard" tabindex="0" role="button" aria-pressed="false" aria-label="ID card. Press to flip.">
            <div class="idin">
              <div class="face front">
                <div class="band">DEVELOPER ID</div>
                <div class="ph"><img class="pimg" alt="Shreyas V ID photo" width="480" height="600"></div>
                <div class="idn">Shreyas V</div>
                <div class="idr">DevOps &amp; Database Engineer</div>
                <div class="idrows">
                  <div><span>Org.</span><b>TCS</b></div>
                  <div><span>Since</span><b>April 2025</b></div>
                  <div><span>Degree</span><b>MCA · 2024</b></div>
                </div>
                <div class="idfoot"><div class="barcode" aria-hidden="true"></div><div class="holo" aria-hidden="true"></div></div>
              </div>
              <div class="face back">
                <h4>What I am</h4>
                <ul>
                  <li>DevOps &amp; Database Engineer at TCS</li>
                  <li>MCA, Graduated with Distinction</li>
                  <li>5 Microsoft certifications</li>
                  <li>Azure · PostgreSQL · Terraform</li>
                  <li>AWS-to-Azure migration</li>
                </ul>
                <div class="sign">Shreyas<small>If found, say hello · shreyasvpersonal@gmail.com</small></div>
              </div>
            </div>
          </div>
        </div>
        <div class="hint">Hover, tap or press Enter to flip</div>
      </div>
      <div class="about-r rv">
        <h3>Quick facts</h3>
        <div class="qf">
          <div><span>Location</span><b>Bengaluru, India</b></div>
          <div><span>Education</span><b>MCA, Atria Institute of Technology</b></div>
          <div><span>Current role</span><b>DevOps &amp; Database Engineer, TCS</b></div>
          <div><span>Email</span><b>shreyasvpersonal@gmail.com</b></div>
        </div>
        <p class="quote">Keeping production databases recoverable and cloud infrastructure repeatable.</p>
      </div>
    </div>
  </div>
</section>

<!-- SKILLS -->
<section class="sec" id="skills">
  <div class="wrap">
    <div class="skills-top">
      <div>
        <p class="tag rv">02 — Skills</p>
        <h2 class="rv-mask"><span>The periodic table <br>of my <em>stack.</em></span></h2>
      </div>
      <p class="rv" style="max-width:34ch;color:var(--mute);font-size:15px">Every skill from my résumé as an element. Filter by family, then hover or focus a tile to inspect it.</p>
    </div>
    <div class="chips rv" id="chips" role="group" aria-label="Filter skills by family"></div>
    <div class="ptable">
      <div class="grid" id="grid"></div>
      <aside class="insp" id="insp" aria-live="polite"></aside>
    </div>
  </div>
</section>

<!-- CERTIFICATIONS -->
<section class="sec band-w" id="certifications">
  <div class="wrap certs">
    <div class="stick">
      <p class="tag rv">03 — Certifications</p>
      <h2 class="rv-mask"><span>Always <em>learning.</em></span></h2>
      <p class="count rv">5 Microsoft certifications</p>
    </div>
    <div id="certList"></div>
  </div>
</section>

<!-- EXPERIENCE -->
<section class="sec" id="experience">
  <div class="wrap">
    <p class="tag rv">04 — Experience &amp; education</p>
    <h2 class="rv-mask"><span>The path <em>so far.</em></span></h2>
    <div class="tl" id="tl">
      <div class="spine"><i id="spine"></i></div>
      <div class="stop"><div class="yr">2019 – 2022</div><h3>Bachelor of Computer Applications</h3><div class="pl">University of Mysore</div></div>
      <div class="stop"><div class="yr">2022 – 2024</div><h3>Master of Computer Applications</h3><div class="pl">Atria Institute of Technology</div><span class="dist">Graduated with Distinction</span></div>
      <div class="stop"><div class="yr">April 2025 – Present · Bengaluru</div><h3>DevOps &amp; Database Engineer</h3><div class="pl">Tata Consultancy Services (TCS)</div>
        <ul>
          <li>Administer PostgreSQL databases across Development, QA, UAT and Production environments.</li>
          <li>Perform cluster and database restoration, recovery and DR activities for business continuity.</li>
          <li>Execute data migration, role migration and AWS-to-Azure database migration with validation and access checks.</li>
          <li>Provision Azure infrastructure with Terraform; configure NSGs, Azure Policy and RBAC.</li>
          <li>Build, maintain and troubleshoot Azure DevOps CI/CD pipelines; use GitHub Actions for automation.</li>
          <li>Monitor with Grafana, Dynatrace and Splunk; take part in AI initiatives with Agentic AI, LangChain, RAG and Azure AI Foundry.</li>
        </ul>
      </div>
      <div class="next"><b>Next — your team?</b><a class="btn btn-p" href="#contact">Let's talk</a></div>
    </div>
  </div>
</section>

<!-- ACHIEVEMENTS -->
<section class="ach" id="achievements" aria-label="Achievements">
  <div class="pin" id="pin">
    <div class="wrap" style="width:100%">
      <div class="ach-head">
        <div>
          <p class="tag">05 — Achievements</p>
          <h2>Things that <em>shipped.</em></h2>
        </div>
        <div><div class="pbar" aria-hidden="true"><i id="abar"></i></div><p style="font-size:13px;color:var(--mute)">Scroll to slide</p></div>
      </div>
    </div>
    <div class="track" id="track"></div>
  </div>
</section>

<!-- CONTACT -->
<section class="sec contact" id="contact">
  <div class="wrap" style="position:relative">
    <svg class="badge" viewBox="0 0 140 140" aria-hidden="true"><defs><path id="c" d="M70,70 m-52,0 a52,52 0 1,1 104,0 a52,52 0 1,1 -104,0"/></defs><text><textPath href="#c">SAY HELLO • SAY HELLO • SAY HELLO • </textPath></text></svg>
    <p class="tag rv">06 — Contact</p>
    <h2 id="cHead" aria-label="Let's build something together.">Let's build<br><em>something together.</em></h2>
    <div class="mail rv">
      <a class="big" id="mailLink" href="mailto:shreyasvpersonal@gmail.com">shreyasvpersonal@gmail.com</a>
      <button class="copy" id="copyBtn" aria-live="polite">Copy</button>
    </div>
    <div class="links2 rv">
      <a class="btn btn-p" href="tel:+919535252488">+91 95352 52488</a>
      <a class="btn btn-s" href="https://github.com/Shreyasv006" target="_blank" rel="noopener">GitHub ↗</a>
      <a class="btn btn-s" href="https://www.linkedin.com/in/shreyasv006" target="_blank" rel="noopener">LinkedIn ↗</a>
    </div>
  </div>
</section>
</main>
<footer><div class="wrap"><span id="yr">© Shreyas V</span><a href="#top">Back to top ↑</a><span>Bengaluru, India</span></div></footer>

<script>
const PORTRAIT="data:image/webp;base64,";
document.querySelectorAll('.pimg').forEach(i=>i.src=PORTRAIT);
document.getElementById('yr').textContent='© '+new Date().getFullYear()+' Shreyas V';
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];

/* reveal */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-in');io.unobserve(e.target)}}),{threshold:.12});
$$('.rv,.rv-mask').forEach(el=>io.observe(el));
// hero reveals immediately
requestAnimationFrame(()=>$$('#hero .rv,#hero .rv-mask').forEach(el=>el.classList.add('is-in')));

/* nav */
const nav=$('#nav'),pill=$('#pill'),links=$$('#links a'),bar=$('#progress');
function movePill(a){if(!a){pill.style.opacity=0;return}
  pill.style.opacity=1;pill.style.width=a.offsetWidth+'px';pill.style.transform='translateX('+(a.offsetLeft)+'px)'}
let activeLink=null;
function setActive(id){activeLink=links.find(a=>a.getAttribute('href')==='#'+id)||null;links.forEach(a=>a.classList.toggle('on',a===activeLink));movePill(activeLink)}
const so=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)setActive(e.target.id)}),{rootMargin:'-45% 0px -50% 0px'});
$$('main section[id]').forEach(s=>so.observe(s));
addEventListener('resize',()=>movePill(activeLink));
const menuBtn=$('#menuBtn'),ov=$('#overlay');
function toggleMenu(o){ov.classList.toggle('open',o);document.body.classList.toggle('lock',o);menuBtn.setAttribute('aria-expanded',o)}
menuBtn.onclick=()=>toggleMenu(true);$('#closeBtn').onclick=()=>toggleMenu(false);
$$('#overlay a').forEach(a=>a.onclick=()=>toggleMenu(false));
addEventListener('keydown',e=>{if(e.key==='Escape')toggleMenu(false)});

/* skills data */
const FAM={
 Cloud:'Provision and manage Microsoft Azure resources supporting enterprise application workloads and production environments.',
 Database:'Administer PostgreSQL databases across Development, QA, UAT and Production environments.',
 'DB Admin':'Cluster and database restoration, recovery, migration and role management, with validation and access checks.',
 DevOps:'Build, maintain and troubleshoot Azure DevOps CI/CD pipelines; GitHub Actions for automation alongside Git-based source control.',
 IaC:'Provision Azure infrastructure using Terraform, following Infrastructure as Code principles for repeatable deployments.',
 Security:'Configure Azure NSGs, Azure Policy, RBAC and secure connectivity controls per environment requirements.',
 Programming:'Languages listed in my technical skills: Java, C#, .NET, Python and SQL.',
 Monitoring:'Monitoring and investigation across infrastructure and application environments.',
 'AI / Data':'Practical exposure to Agentic AI, AI Agents, LangChain, RAG, Azure AI Foundry, Azure Databricks and SQL AI.'};
const FCOL={Cloud:'#0ea5e9',Database:'#6366f1','DB Admin':'#8b5cf6',DevOps:'#10b981',IaC:'#d946ef',Security:'#f59e0b',Programming:'#f43f5e',Monitoring:'#14b8a6','AI / Data':'#ec4899'};
const SK=[
['Az','Microsoft Azure','Cloud'],['Po','Azure Portal','Cloud'],['St','Azure Storage','Cloud'],['Aw','AWS (migration)','Cloud'],
['Pg','PostgreSQL','Database'],['My','MySQL','Database'],['Sq','SQL','Database'],['Pa','pgAdmin','Database'],
['Cr','Cluster restoration','DB Admin'],['Dr','Disaster recovery','DB Admin'],['Dm','Data migration','DB Admin'],['Rm','Role migration','DB Admin'],['Sm','Schema management','DB Admin'],
['Ad','Azure DevOps','DevOps'],['Ga','GitHub Actions','DevOps'],['Ci','CI/CD pipelines','DevOps'],['Gt','Git','DevOps'],['Gh','GitHub','DevOps'],['Bb','Bitbucket','DevOps'],['Jk','Jenkins','DevOps'],
['Tf','Terraform','IaC'],['Bi','Bicep','IaC'],
['Ns','Azure NSG','Security'],['Ap','Azure Policy','Security'],['Rb','RBAC','Security'],['Ip','IP source config','Security'],['Ac','DB access controls','Security'],
['Ja','Java','Programming'],['C#','C#','Programming'],['Nt','.NET','Programming'],['Py','Python','Programming'],
['Gr','Grafana','Monitoring'],['Dy','Dynatrace','Monitoring'],['Sp','Splunk','Monitoring'],
['Db','Azure Databricks','AI / Data'],['Af','Azure AI Foundry','AI / Data'],['Sa','SQL AI','AI / Data'],['Ag','Agentic AI','AI / Data'],['Ai','AI Agents','AI / Data'],['Lc','LangChain','AI / Data'],['Rg','RAG','AI / Data']];
const grid=$('#grid'),insp=$('#insp'),chips=$('#chips');
let filter='All';
function show(i,pop){const s=SK[i];insp.style.setProperty('--c',FCOL[s[2]]);insp.innerHTML='<div class="big'+(pop?' pop':'')+'" aria-hidden="true">'+s[0]+'</div><h3>'+s[1]+'</h3><div class="fam">No. '+String(i+1).padStart(2,'0')+' · '+s[2]+'</div><p>'+FAM[s[2]]+'</p>';
  $$('.tile').forEach((t,k)=>t.classList.toggle('sel',k===i))}
SK.forEach((s,i)=>{const b=document.createElement('button');b.className='tile';b.dataset.f=s[2];b.style.setProperty('--c',FCOL[s[2]]);
  const r=Math.floor(i/8),c=i%8;b.style.setProperty('--d',((window.innerWidth<640?Math.floor(i/4)+i%4:r+c)*40)+'ms');
  b.setAttribute('aria-label',s[1]+', '+s[2]);
  b.innerHTML='<span class="n">'+(i+1)+'</span><span class="s">'+s[0]+'</span><span class="m">'+s[1]+'</span>';
  b.onmouseenter=()=>show(i,true);b.onfocus=()=>show(i,true);b.onclick=()=>show(i,true);grid.appendChild(b)});
['All',...Object.keys(FAM)].forEach(f=>{const b=document.createElement('button');b.className='chip'+(f==='All'?' on':'');if(FCOL[f])b.style.setProperty('--c',FCOL[f]);b.textContent=f;
  b.onclick=()=>{filter=f;$$('.chip').forEach(c=>c.classList.toggle('on',c===b));$$('.tile').forEach(t=>t.classList.toggle('dim',f!=='All'&&t.dataset.f!==f))};chips.appendChild(b)});
show(0,false);
new IntersectionObserver((es,o)=>{if(es[0].isIntersecting){grid.classList.add('in');o.disconnect()}},{threshold:.1}).observe(grid);

/* certs */
const CERTS=[['Azure Administrator Associate','AZ-104','https://learn.microsoft.com/api/credentials/share/en-gb/ShreyasV-6222/7221A16D81D62038?sharingId=244CBC0D8F1B1EC9'],['Azure DevOps Engineer Expert','AZ-400','https://learn.microsoft.com/api/credentials/share/en-gb/ShreyasV-6222/4D737E49623581C5?sharingId=244CBC0D8F1B1EC9'],['Azure AI Engineer Associate','AI-102','https://learn.microsoft.com/api/credentials/share/en-gb/ShreyasV-6222/7D0EB48B814D86C?sharingId=244CBC0D8F1B1EC9'],['Azure Databricks Data Engineer Associate','DP-750','https://learn.microsoft.com/api/credentials/share/en-gb/ShreyasV-6222/88833BB184C64C47?sharingId=244CBC0D8F1B1EC9'],['SQL AI Developer Associate','DP-800','https://learn.microsoft.com/api/credentials/share/en-gb/ShreyasV-6222/2EDE28A7FC84A6F?sharingId=244CBC0D8F1B1EC9']];
$('#certList').innerHTML=CERTS.map((c,i)=>'<a class="crow rv" style="--i:'+i+'" href="'+c[2]+'" target="_blank" rel="noopener noreferrer" aria-label="Microsoft Certified: '+c[0]+' ('+c[1]+'), opens credential in a new tab"><span class="i">'+String(i+1).padStart(2,'0')+'</span><span class="t">Microsoft Certified: '+c[0]+'<small>'+c[1]+' · Microsoft · View credential</small></span><span class="a" aria-hidden="true">↗</span></a>').join('');
$$('.crow').forEach(el=>io.observe(el));

/* achievements */
const ACH=[
 {l:'AWS-to-Azure migration',c:'Contributed to migration and enterprise PostgreSQL operations across multiple environments.',t:'AWS→Azure',g:'Az'},
 {l:'Disaster recovery',c:'PostgreSQL cluster and database restoration supporting operational continuity.',t:'DR',g:'Dr'},
 {l:'Automation',c:'Azure infrastructure with Terraform; CI/CD via Azure DevOps and GitHub Actions.',t:'Terraform',g:'Tf'},
 {l:'Environments supported',c:'Development, QA, UAT and Production PostgreSQL.',n:4,g:'Pg'},
 {l:'Microsoft certifications',c:'Azure Administration, DevOps, AI, Databricks and SQL AI.',n:5,g:'Ms'},
 {l:'Years at TCS',c:'Since April 2025 as DevOps & Database Engineer.',n:1.7,d:1,s:'+',g:'Yr'}];
const track=$('#track');
track.innerHTML=ACH.map((a,i)=>'<div class="acard"><div class="top"><div class="logo" aria-hidden="true">'+a.g+'</div><span class="idx">'+String(i+1).padStart(2,'0')+' / '+String(ACH.length).padStart(2,'0')+'</span></div><div class="bot"><div><div class="lb">'+a.l+'</div><div class="cp">'+a.c+'</div></div>'+(a.n!=null?'<div class="num" data-n="'+a.n+'" data-d="'+(a.d||0)+'" data-s="'+(a.s||'')+'" aria-label="'+a.n+(a.s||'')+'">0</div>':'<div class="num t">'+a.t+'</div>')+'</div></div>').join('')+'<div class="end">and counting →</div>';
const cio=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;cio.unobserve(e.target);const n=e.target.querySelector('[data-n]');if(!n)return;
  const to=+n.dataset.n,d=+n.dataset.d,s=n.dataset.s;if(RM){n.textContent=to.toFixed(d)+s;return}
  const t0=performance.now();(function f(t){const p=Math.min((t-t0)/1400,1),e4=1-Math.pow(1-p,4);n.textContent=(to*e4).toFixed(d)+(p===1?s:'');if(p<1)requestAnimationFrame(f)})(t0)}),{threshold:.6});
$$('.acard').forEach(c=>cio.observe(c));
const ach=$('#achievements'),pin=$('#pin'),abar=$('#abar');
function sizeAch(){
  if(innerWidth<=700){ach.style.removeProperty('--ah');return}
  const travel=Math.max(0,track.scrollWidth-innerWidth);ach.style.setProperty('--ah',(innerHeight+travel)+'px')}
sizeAch();addEventListener('resize',sizeAch);addEventListener('load',sizeAch);

/* lanyard */
const swing=$('#swing'),idc=$('#idcard'),lan=$('#lanyard');
let ang=0,vel=0,lastX=null,vis=false,tt=0;
new IntersectionObserver(es=>vis=es[0].isIntersecting).observe(lan);
addEventListener('pointermove',e=>{if(lastX!==null&&vis)vel+=(e.clientX-lastX)*.012;lastX=e.clientX},{passive:true});
(function loop(){requestAnimationFrame(loop);if(!vis||RM)return;tt+=.016;
  vel+=-ang*.018-vel*.035;vel+=Math.sin(tt*1.1)*.0035;ang+=vel;ang=Math.max(-18,Math.min(18,ang));
  swing.style.transform='rotate('+ang.toFixed(3)+'deg)'})();
function flip(v){const f=v===undefined?!idc.classList.contains('flip'):v;idc.classList.toggle('flip',f);idc.setAttribute('aria-pressed',f)}
idc.addEventListener('click',()=>flip());
idc.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();flip()}});
if(matchMedia('(hover:hover)').matches){idc.addEventListener('mouseenter',()=>flip(true));idc.addEventListener('mouseleave',()=>flip(false))}

/* scroll driven */
const tl=$('#tl'),spine=$('#spine'),stops=$$('.stop');
function onScroll(){
  const st=scrollY,max=document.documentElement.scrollHeight-innerHeight;
  bar.style.transform='scaleX('+(max>0?st/max:0)+')';
  nav.classList.toggle('scrolled',st>40);
  // timeline
  const r=tl.getBoundingClientRect(),p=Math.max(0,Math.min(1,(innerHeight*.6-r.top)/r.height));
  spine.style.transform='scaleY('+p+')';
  stops.forEach(s=>{const sr=s.getBoundingClientRect();s.classList.toggle('lit',sr.top<innerHeight*.62)});
  // achievements
  if(innerWidth>700){
    const a=ach.getBoundingClientRect(),travel=Math.max(0,track.scrollWidth-innerWidth),q=Math.max(0,Math.min(1,-a.top/Math.max(1,a.height-innerHeight)));
    track.style.transform='translate3d('+(-q*travel).toFixed(1)+'px,0,0)';abar.style.transform='scaleX('+q+')';
  }
  const cx=innerWidth/2;let best=null,bd=1e9;
  $$('.acard').forEach(c=>{const b=c.getBoundingClientRect(),d=Math.abs(b.left+b.width/2-cx);if(d<bd){bd=d;best=c}});
  $$('.acard').forEach(c=>c.classList.toggle('near',c===best&&ach.getBoundingClientRect().top<innerHeight*.5&&ach.getBoundingClientRect().bottom>innerHeight*.5));
}
addEventListener('scroll',onScroll,{passive:true});addEventListener('resize',onScroll);onScroll();

/* contact */
const ch=$('#cHead');
let idx=0;(function(){const walk=n=>{[...n.childNodes].forEach(c=>{if(c.nodeType===3){const f=document.createDocumentFragment();[...c.textContent].forEach(ch=>{if(ch===' '){f.appendChild(document.createTextNode(' '))}else{const s=document.createElement('span');s.className='l';if(n.tagName==='EM'){const P=['#6d5efc','#00b8ff','#ff5fa2','#ffb86b'];s.style.color=P[(idx++)%4];s.style.webkitTextFillColor='currentColor'}s.setAttribute('aria-hidden','true');s.textContent=ch;s.addEventListener('mouseenter',()=>{s.classList.add('hop');setTimeout(()=>s.classList.remove('hop'),260)});f.appendChild(s)}});c.replaceWith(f)}else if(c.nodeType===1&&c.tagName!=='BR')walk(c)})};walk(ch)})();
$('#copyBtn').onclick=async()=>{const b=$('#copyBtn');try{await navigator.clipboard.writeText('shreyasvpersonal@gmail.com');b.textContent='Copied ✓'}catch(e){b.textContent='Select & copy'}setTimeout(()=>b.textContent='Copy',1800)};

/* spoken intro (browser speech, no audio file) */
const introBtn=$('#introBtn'),speak=$('#speak'),sTxt=$('#speakTxt');
const SCRIPT="Hi, I'm Shreyas V. I'm a DevOps and Database Engineer at Tata Consultancy Services, with over one point seven years of experience in Microsoft Azure, Post gress Q L, C I C D, and Terraform.";
function stopSpeak(){if('speechSynthesis' in window)speechSynthesis.cancel();speak.classList.remove('speaking');introBtn.textContent='▶ Introduce me';introBtn.setAttribute('aria-label','Play spoken introduction');sTxt.textContent='Tap “Introduce me” to hear a short intro.'}
introBtn.onclick=()=>{
  if(!('speechSynthesis' in window)){sTxt.textContent='Spoken intro is not supported in this browser.';return}
  if(speak.classList.contains('speaking')){stopSpeak();return}
  const u=new SpeechSynthesisUtterance(SCRIPT);u.rate=1;u.lang='en-IN';
  u.onend=u.onerror=stopSpeak;speechSynthesis.cancel();speechSynthesis.speak(u);
  speak.classList.add('speaking');introBtn.textContent='❚❚ Stop';introBtn.setAttribute('aria-label','Stop spoken introduction');sTxt.textContent='Speaking…'};
new IntersectionObserver(es=>{if(!es[0].isIntersecting&&speak.classList.contains('speaking'))stopSpeak()},{threshold:.35}).observe($('#hero'));

/* ===== MAGIC ===== */
(function(){
const fine=matchMedia('(hover:hover) and (pointer:fine)').matches;
const COL=['#6d5efc','#00b8ff','#ff5fa2','#ffb86b'];
const cv=document.createElement('canvas');cv.id='fx';cv.setAttribute('aria-hidden','true');document.body.appendChild(cv);
const c=cv.getContext('2d');let W,H;const D=Math.min(devicePixelRatio||1,2);
function rs(){W=innerWidth;H=innerHeight;cv.width=W*D;cv.height=H*D;c.setTransform(D,0,0,D,0,0)}rs();addEventListener('resize',rs);
const amb=[],N=innerWidth<700?20:42;
for(let i=0;i<N;i++)amb.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.28,vy:(Math.random()-.5)*.28,r:Math.random()*1.6+.7,c:COL[i%4]});
const fx=[];let mx=-999,my=-999,lx=0,ly=0,sx=0,sy=0;const spot=document.getElementById('spot');
addEventListener('pointermove',e=>{mx=e.clientX;my=e.clientY;if(fine)spot.classList.add('on');
  if(!fine||RM)return;if(Math.hypot(mx-lx,my-ly)>16){lx=mx;ly=my;for(let k=0;k<2;k++)fx.push({x:mx,y:my,vx:(Math.random()-.5)*1.3,vy:(Math.random()-.5)*1.3+.3,l:1,s:Math.random()*5+3,c:COL[Math.random()*4|0],star:1,d:.022,g:.02})}},{passive:true});
document.addEventListener('pointerleave',()=>spot.classList.remove('on'));
window.burst=(x,y)=>{if(RM)return;for(let i=0;i<54;i++){const a=Math.random()*6.283,sp=Math.random()*7+2;fx.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-3,l:1,s:Math.random()*6+3,c:COL[i%4],d:.011,g:.2,rot:Math.random()*6,vr:(Math.random()-.5)*.4})}};
function star(x,y,r,col,a){c.save();c.globalAlpha=a;c.fillStyle=col;c.shadowColor=col;c.shadowBlur=10;c.translate(x,y);c.beginPath();for(let i=0;i<8;i++){const rr=i%2?r*.3:r,t=i*Math.PI/4;c.lineTo(Math.cos(t)*rr,Math.sin(t)*rr)}c.closePath();c.fill();c.restore()}
(function frame(){requestAnimationFrame(frame);if(document.hidden||RM)return;
  c.clearRect(0,0,W,H);
  if(fine){sx+=(mx-sx)*.14;sy+=(my-sy)*.14;spot.style.transform='translate3d('+sx+'px,'+sy+'px,0)'}
  for(const p of amb){p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=W;if(p.x>W)p.x=0;if(p.y<0)p.y=H;if(p.y>H)p.y=0;
    const dx=p.x-mx,dy=p.y-my,d=Math.hypot(dx,dy);if(d<130&&d>0){p.x+=dx/d*1.2;p.y+=dy/d*1.2}}
  c.lineWidth=1;
  for(let i=0;i<amb.length;i++){const a=amb[i];
    for(let j=i+1;j<amb.length;j++){const b=amb[j],d=Math.hypot(a.x-b.x,a.y-b.y);if(d<110){c.globalAlpha=(1-d/110)*.16;c.strokeStyle=a.c;c.beginPath();c.moveTo(a.x,a.y);c.lineTo(b.x,b.y);c.stroke()}}
    const dm=Math.hypot(a.x-mx,a.y-my);if(fine&&dm<170){c.globalAlpha=(1-dm/170)*.45;c.strokeStyle=a.c;c.beginPath();c.moveTo(a.x,a.y);c.lineTo(mx,my);c.stroke()}
    c.globalAlpha=.55;c.fillStyle=a.c;c.beginPath();c.arc(a.x,a.y,a.r,0,6.283);c.fill()}
  for(let i=fx.length-1;i>=0;i--){const p=fx[i];p.x+=p.vx;p.y+=p.vy;p.vy+=p.g;p.l-=p.d;if(p.l<=0){fx.splice(i,1);continue}
    if(p.star)star(p.x,p.y,p.s*p.l,p.c,p.l);else{p.rot+=p.vr;c.save();c.globalAlpha=Math.min(1,p.l*1.5);c.fillStyle=p.c;c.translate(p.x,p.y);c.rotate(p.rot);c.fillRect(-p.s/2,-p.s/4,p.s,p.s/2);c.restore()}}
  c.globalAlpha=1})();
if(fine&&!RM){
  document.querySelectorAll('.fact,.acard,.insp').forEach(el=>{
    el.addEventListener('pointermove',e=>{const r=el.getBoundingClientRect(),px=(e.clientX-r.left)/r.width-.5,py=(e.clientY-r.top)/r.height-.5;el.style.transition='transform .12s ease-out,box-shadow .8s';el.style.setProperty('--ry',(px*10).toFixed(2)+'deg');el.style.setProperty('--rx',(-py*10).toFixed(2)+'deg')});
    el.addEventListener('pointerleave',()=>{el.style.transition='';el.style.setProperty('--ry','0deg');el.style.setProperty('--rx','0deg')})});
  document.querySelectorAll('.btn,.copy,.menu-btn').forEach(el=>{
    el.addEventListener('pointermove',e=>{const r=el.getBoundingClientRect();el.style.transform='translate('+((e.clientX-r.left-r.width/2)*.22).toFixed(1)+'px,'+((e.clientY-r.top-r.height/2)*.3).toFixed(1)+'px)'});
    el.addEventListener('pointerleave',()=>el.style.transform='')})}
document.querySelector('.portrait-wrap').addEventListener('click',e=>burst(e.clientX,e.clientY));
document.getElementById('copyBtn').addEventListener('click',e=>{const r=e.currentTarget.getBoundingClientRect();burst(r.left+r.width/2,r.top)});
document.getElementById('introBtn').addEventListener('click',e=>{const r=e.currentTarget.getBoundingClientRect();burst(r.left+r.width/2,r.top)});
document.getElementById('grid').addEventListener('click',e=>{if(e.target.closest('.tile'))burst(e.clientX||innerWidth/2,e.clientY||innerHeight/2)});

/* quick-jump palette: Ctrl/Cmd + K */
const mac=/Mac|iPhone|iPad/.test(navigator.platform||navigator.userAgent);
const kb=document.createElement('button');kb.className='kbtn';kb.textContent='Quick jump  '+(mac?'⌘K':'Ctrl K');kb.setAttribute('aria-label','Open quick jump menu');document.body.appendChild(kb);
const cmd=document.createElement('div');cmd.className='cmd';cmd.setAttribute('role','dialog');cmd.setAttribute('aria-modal','true');cmd.setAttribute('aria-label','Quick jump');
cmd.innerHTML='<div class="cmd-box"><input placeholder="Jump to a section or run an action…" aria-label="Search commands"><ul role="listbox"></ul></div>';document.body.appendChild(cmd);
const inp=cmd.querySelector('input'),ul=cmd.querySelector('ul');
const go=id=>()=>document.getElementById(id).scrollIntoView({behavior:RM?'auto':'smooth'});
const ITEMS=[['About','section',go('about')],['Skills','section',go('skills')],['Certifications','section',go('certifications')],['Experience','section',go('experience')],['Achievements','section',go('achievements')],['Contact','section',go('contact')],
 ['Play spoken intro','action',()=>{go('hero')();setTimeout(()=>document.getElementById('introBtn').click(),500)}],
 ['Copy email','action',()=>document.getElementById('copyBtn').click()],
 ['Open GitHub','link',()=>window.open('https://github.com/Shreyasv006','_blank','noopener')],
 ['Open LinkedIn','link',()=>window.open('https://www.linkedin.com/in/shreyasv006','_blank','noopener')],
 ['Celebrate','magic',()=>{for(let i=0;i<5;i++)setTimeout(()=>burst(innerWidth*(.15+Math.random()*.7),innerHeight*(.25+Math.random()*.3)),i*160)}]];
let sel=0,list=ITEMS;
function draw(){ul.innerHTML=list.map((it,i)=>'<li role="option" class="'+(i===sel?'on':'')+'" data-i="'+i+'"><span>'+it[0]+'</span><small>'+it[1]+'</small></li>').join('')}
function openCmd(o){cmd.classList.toggle('open',o);if(o){inp.value='';list=ITEMS;sel=0;draw();setTimeout(()=>inp.focus(),30)}}
function run(i){const it=list[i];if(!it)return;openCmd(false);setTimeout(it[2],60)}
kb.onclick=()=>openCmd(true);
cmd.addEventListener('click',e=>{if(e.target===cmd)openCmd(false);const li=e.target.closest('li');if(li)run(+li.dataset.i)});
inp.addEventListener('input',()=>{const q=inp.value.toLowerCase();list=ITEMS.filter(i=>i[0].toLowerCase().includes(q));sel=0;draw()});
addEventListener('keydown',e=>{
  if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();openCmd(!cmd.classList.contains('open'));return}
  if(!cmd.classList.contains('open'))return;
  if(e.key==='Escape')openCmd(false);
  else if(e.key==='ArrowDown'){e.preventDefault();sel=Math.min(list.length-1,sel+1);draw()}
  else if(e.key==='ArrowUp'){e.preventDefault();sel=Math.max(0,sel-1);draw()}
  else if(e.key==='Enter'){e.preventDefault();run(sel)}});
})();
</script>
</body>
</html>
